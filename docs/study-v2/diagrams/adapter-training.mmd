  classDef frozen fill:#e2efeb,stroke:#4d8075,color:#153a32,stroke-width:1.5px;
  classDef learn fill:#154c4f,stroke:#154c4f,color:#ffffff,stroke-width:2px;
  classDef check fill:#f6efdf,stroke:#967a48,color:#47391f,stroke-width:1.5px;
